<Window x:Class="TaskDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="装机任务管理器 - TaskDesk"
        MinWidth="1120"
        MinHeight="680"
        Foreground="{DynamicResource ForegroundBrush}"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}">
            <DockPanel Margin="12,10,12,6">
                <TextBox DockPanel.Dock="Right" Width="270" Height="30" Margin="12,0,0,0" IsReadOnly="True" Text="在资源库中搜索" />
                <TextBox Height="30" IsReadOnly="True" Text="{Binding RootAddress}" />
            </DockPanel>
            <ToolBarTray>
                <ToolBar>
                    <Button Content="新建" Command="{Binding NewTaskCommand}" />
                    <Button Content="剪切" Command="{Binding CutTaskCommand}" />
                    <Button Content="复制" Command="{Binding CopyTaskCommand}" />
                    <Button Content="粘贴" Command="{Binding PasteTaskCommand}" />
                    <Button Content="重命名" Click="RenameTask_Click" />
                    <Button Content="删除" Click="DeleteTask_Click" />
                    <Separator />
                    <Button Content="排序" Click="SortTasks_Click" />
                    <Button Content="返回" Command="{Binding GoUpCommand}" />
                    <Button Content="选择资源库" Click="SelectResourceLibrary_Click" />
                    <Button Content="更多" Click="More_Click" />
                </ToolBar>
            </ToolBarTray>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" Text="任务列表" Margin="4,4,4,10" />
                    <ListBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask, Mode=TwoWay}" DisplayMemberPath="Title" />
                </DockPanel>
            </Border>
            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding CurrentDirectoryDisplay}" Margin="4,4,4,10" />
                    <ListView ItemsSource="{Binding ResourceEntries}" SelectedItem="{Binding SelectedResource, Mode=TwoWay}" MouseDoubleClick="ResourceList_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名称" DisplayMemberBinding="{Binding Name}" Width="230" />
                                <GridViewColumn Header="修改日期" DisplayMemberBinding="{Binding ModifiedAt}" Width="150" />
                                <GridViewColumn Header="类型" DisplayMemberBinding="{Binding Type}" Width="120" />
                                <GridViewColumn Header="大小" DisplayMemberBinding="{Binding DisplaySize}" Width="110" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
            <Border Grid.Column="2">
                <DockPanel Margin="16">
                    <TextBlock DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" Text="介绍文件" Margin="0,0,0,12" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        <StatusBar Grid.Row="2">
            <StatusBarItem Content="{Binding StatusMessage}" />
            <Separator />
            <StatusBarItem Content="只读资源库" />
        </StatusBar>
    </Grid>
</Window>