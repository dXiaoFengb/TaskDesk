<Window x:Class="TaskDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="装机任务管理器 - TaskDesk"
        MinWidth="1024"
        MinHeight="640"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}">
            <DockPanel Margin="12,10,12,6">
                <TextBox DockPanel.Dock="Right" Width="260" Height="30" IsReadOnly="True"
                         Text="在资源库中搜索" />
                <TextBox Height="30" Margin="0,0,10,0" IsReadOnly="True"
                         Text="资源库" />
            </DockPanel>
            <ToolBarTray>
                <ToolBar>
                    <Button Content="新建" />
                    <Button Content="剪切" />
                    <Button Content="复制" />
                    <Button Content="粘贴" />
                    <Button Content="重命名" />
                    <Button Content="删除" />
                    <Separator />
                    <Button Content="排序" />
                    <Button Content="查看" />
                    <Button Content="更多" />
                </ToolBar>
            </ToolBarTray>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <TreeView Margin="8" />
            </Border>
            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <ListView Margin="8" />
            </Border>
            <Border Grid.Column="2">
                <TextBlock Margin="16" Text="选择要预览的文件。" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</Window>
